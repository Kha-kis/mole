def main():
    import argparse

    parser = argparse.ArgumentParser(
        description=f"MOLE v{VERSION} - Managed Obfuscated Link Environment",
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog="""
Commands:
  init        Initialize directory structure and config
  status      Show current VPN status
  ip          Show current public IP through VPN
  regions     List available VPN regions
  autoselect  Find fastest region with port forwarding
  speedtest   Test VPN connection speed
  stats       Show bandwidth statistics
  validate    Validate configuration file
  qbittorrent Manage qBittorrent in VPN namespace
  restart     Force VPN reconnection
  stop        Stop the VPN service
  logs        Show service logs
  run         Run the VPN manager (default, used by systemd)

Examples:
  sudo mole init               # First-time setup
  mole validate                # Check config for errors
  sudo mole status             # Check VPN status
  mole ip                      # Show VPN public IP
  mole regions pia             # List PIA regions
  mole regions pia --pf        # Only regions with port forwarding
  mole autoselect              # Find fastest region
  mole speedtest               # Test VPN speed
  mole stats                   # Show bandwidth usage
  sudo mole qbittorrent setup  # Setup qBittorrent in VPN namespace
  sudo mole qbittorrent start  # Start qBittorrent service
  mole qbittorrent status      # Check qBittorrent status
  sudo mole restart            # Force reconnection
  sudo mole stop               # Stop the service
  mole logs -f                 # Follow logs
"""
    )

    parser.add_argument(
        "-v", "--version",
        action="version",
        version=f"MOLE v{VERSION}"
    )

    subparsers = parser.add_subparsers(dest="command", help="Command to run")

    # init command
    init_parser = subparsers.add_parser("init", help="Initialize MOLE")
    init_parser.add_argument(
        "-f", "--force",
        action="store_true",
        help="Overwrite existing files"
    )

    # status command
    status_parser = subparsers.add_parser("status", help="Show VPN status")

    # ip command
    ip_parser = subparsers.add_parser("ip", help="Show current public IP")

    # regions command
    regions_parser = subparsers.add_parser("regions", help="List VPN regions")
    regions_parser.add_argument(
        "provider",
        nargs="?",
        default="pia",
        help="VPN provider (default: pia)"
    )
    regions_parser.add_argument(
        "--pf", "--port-forward",
        dest="port_forward",
        action="store_true",
        help="Only show regions with port forwarding"
    )

    # autoselect command
    autoselect_parser = subparsers.add_parser("autoselect", help="Find fastest region")

    # speedtest command
    speedtest_parser = subparsers.add_parser("speedtest", help="Test VPN speed")

    # stats command
    stats_parser = subparsers.add_parser("stats", help="Show bandwidth statistics")
    stats_parser.add_argument(
        "--save",
        action="store_true",
        help="Save current session stats to history"
    )

    # validate command
    validate_parser = subparsers.add_parser("validate", help="Validate config file")
    validate_parser.add_argument(
        "-c", "--config",
        default=DEFAULT_CONFIG_FILE,
        help="Path to configuration file"
    )

    # qbittorrent command
    qb_parser = subparsers.add_parser("qbittorrent", help="Manage qBittorrent in VPN namespace")
    qb_parser.add_argument(
        "action",
        nargs="?",
        default="status",
        choices=["setup", "start", "stop", "status", "enable", "disable"],
        help="Action to perform (default: status)"
    )
    qb_parser.add_argument(
        "--user", "-u",
        help="User to run qBittorrent as (for setup)"
    )
    qb_parser.add_argument(
        "--port", "-p",
        type=int,
        default=8080,
        help="Web UI port (default: 8080)"
    )

    # restart command
    restart_parser = subparsers.add_parser("restart", help="Force VPN reconnection")

    # stop command
    stop_parser = subparsers.add_parser("stop", help="Stop the VPN service")

    # logs command
    logs_parser = subparsers.add_parser("logs", help="Show service logs")
    logs_parser.add_argument(
        "-f", "--follow",
        action="store_true",
        help="Follow log output"
    )
    logs_parser.add_argument(
        "-n", "--lines",
        type=int,
        default=50,
        help="Number of lines to show (default: 50)"
    )

    # run command
    run_parser = subparsers.add_parser("run", help="Run VPN manager")
    run_parser.add_argument(
        "-c", "--config",
        default=DEFAULT_CONFIG_FILE,
        help="Path to configuration file"
    )

    args = parser.parse_args()

    # Setup logging
    global log
    log = setup_logging(quiet=(args.command in ["status", "ip", "regions", "stats"]))

    # Route to command
    if args.command == "init":
        return cmd_init(args)
    elif args.command == "status":
        return cmd_status(args)
    elif args.command == "ip":
        return cmd_ip(args)
    elif args.command == "regions":
        return cmd_regions(args)
    elif args.command == "autoselect":
        return cmd_autoselect(args)
    elif args.command == "speedtest":
        return cmd_speedtest(args)
    elif args.command == "stats":
        return cmd_stats(args)
    elif args.command == "validate":
        return cmd_validate(args)
    elif args.command == "qbittorrent":
        return cmd_qbittorrent(args)
    elif args.command == "restart":
        return cmd_restart(args)
    elif args.command == "stop":
        return cmd_stop(args)
    elif args.command == "logs":
        return cmd_logs(args)
    elif args.command == "run":
        config_path = getattr(args, 'config', DEFAULT_CONFIG_FILE)
        mole = Mole(config_path)
        asyncio.run(mole.run())
        return 0
    else:
        # No command provided - show help
        parser.print_help()
        return 1


if __name__ == "__main__":
    sys.exit(main())

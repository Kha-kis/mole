def _qbittorrent_setup(args):
    """Setup qBittorrent to run in VPN namespace"""
    print(f"MOLE v{VERSION} - qBittorrent Setup")
    print("=" * 50)

    if os.geteuid() != 0:
        print("Error: setup must be run as root (sudo mole qbittorrent setup)")
        return 1

    # Check if qbittorrent-nox is installed
    result = run_cmd(["which", "qbittorrent-nox"], check=False)
    if result.returncode != 0:
        print("Error: qbittorrent-nox is not installed")
        print("Install with: sudo apt install qbittorrent-nox")
        return 1
    print("qbittorrent-nox: found")

    # Check for existing qbittorrent services
    existing_services = []
    for svc in ['qbittorrent-nox', 'qbittorrent-nox@', 'qbittorrent']:
        # Check both system and user services
        result = subprocess.run(
            ["systemctl", "list-unit-files", f"{svc}*"],
            capture_output=True, text=True
        )
        if svc in result.stdout:
            existing_services.append(svc)

    # Also check if any qbittorrent service is active
    result = subprocess.run(
        ["systemctl", "is-active", "qbittorrent-nox"],
        capture_output=True, text=True
    )
    qb_running = result.stdout.strip() == "active"

    if qb_running or existing_services:
        print(f"\nExisting qBittorrent service detected:")
        result = subprocess.run(
            ["systemctl", "status", "qbittorrent-nox", "--no-pager", "-l"],
            capture_output=True, text=True
        )
        if result.returncode == 0:
            # Show first few lines of status
            for line in result.stdout.split('\n')[:5]:
                print(f"  {line}")

        print("\nThe existing service runs qBittorrent outside the VPN namespace.")
        print("To use MOLE's VPN protection, we need to disable this service.")
        response = input("\nDisable and stop the existing service? [y/N]: ").strip().lower()

        if response in ('y', 'yes'):
            print("\nStopping qbittorrent-nox service...")
            subprocess.run(["systemctl", "stop", "qbittorrent-nox"], check=False)
            print("Disabling qbittorrent-nox service...")
            subprocess.run(["systemctl", "disable", "qbittorrent-nox"], check=False)
            print("Existing service disabled.")
        else:
            print("\nSetup cancelled. Disable the existing service first if you want VPN protection.")
            return 1

    # Get configuration
    config = Config()
    netns = config.netns

    # Get user to run as
    user = getattr(args, 'user', None)
    if not user:
        # Try to find a non-root user
        import pwd
        for p in pwd.getpwall():
            if 1000 <= p.pw_uid < 65000 and p.pw_shell not in ('/bin/false', '/usr/sbin/nologin'):
                user = p.pw_name
                break
        if not user:
            user = input("Enter username to run qBittorrent as: ").strip()
            if not user:
                print("Error: Username required")
                return 1

    # Get port
    port = getattr(args, 'port', 8080)

    print(f"\nConfiguration:")
    print(f"  User: {user}")
    print(f"  Namespace: {netns}")
    print(f"  Web UI Port: {port}")

    # Generate service file
    service_content = QBITTORRENT_SERVICE_TEMPLATE.format(
        user=user,
        netns=netns,
        port=port
    )

    service_path = Path("/etc/systemd/system/qbittorrent-mole.service")

    print(f"\nCreating service: {service_path}")
    service_path.write_text(service_content)

    # Reload systemd
    subprocess.run(["systemctl", "daemon-reload"], check=False)

    print("\nService created successfully!")
    print("\nNext steps:")
    print("  1. Start MOLE first:        sudo systemctl start mole")
    print("  2. Start qBittorrent:       sudo systemctl start qbittorrent-mole")
    print("  3. Enable on boot:          sudo systemctl enable qbittorrent-mole")
    print(f"  4. Access Web UI at:        http://localhost:{port}")
    print(f"                              (or http://{config.veth_vpn_ip}:{port})")

    # Ask if user wants to enable now
    response = input("\nEnable and start qbittorrent-mole now? [Y/n]: ").strip().lower()
    if response not in ('n', 'no'):
        print("\nEnabling qbittorrent-mole...")
        subprocess.run(["systemctl", "enable", "qbittorrent-mole"], check=False)

        # Check if mole is running
        result = subprocess.run(
            ["systemctl", "is-active", "mole"],
            capture_output=True, text=True
        )
        if result.stdout.strip() != "active":
            print("Note: MOLE service is not running. Start it first:")
            print("  sudo systemctl start mole")
        else:
            print("Starting qbittorrent-mole...")
            result = subprocess.run(
                ["systemctl", "start", "qbittorrent-mole"],
                capture_output=True, text=True
            )
            if result.returncode == 0:
                print("qBittorrent started in VPN namespace!")
            else:
                print(f"Failed to start: {result.stderr}")
                return 1

    return 0


def _qbittorrent_control(action):
    """Start/stop/enable/disable qbittorrent-mole service"""
    if os.geteuid() != 0:
        print(f"Error: {action} must be run as root (sudo mole qbittorrent {action})")
        return 1

    service = "qbittorrent-mole"

    # Check if service exists
    result = subprocess.run(
        ["systemctl", "cat", service],
        capture_output=True, text=True
    )
    if result.returncode != 0:
        print(f"Error: {service} service not found")
        print("Run 'sudo mole qbittorrent setup' first")
        return 1

    print(f"{action.capitalize()}ing {service}...")
    result = subprocess.run(
        ["systemctl", action, service],
        capture_output=True, text=True
    )

    if result.returncode == 0:
        print(f"Service {action}ed successfully")

        # Show status after start
        if action == 'start':
            import time
            time.sleep(1)
            _qbittorrent_status()
    else:
        print(f"Failed: {result.stderr}")
        return 1

    return 0


def _qbittorrent_status():
    """Show qbittorrent-mole service status"""
    service = "qbittorrent-mole"

    print(f"MOLE v{VERSION} - qBittorrent Status")
    print("=" * 50)

    # Check if service exists
    result = subprocess.run(
        ["systemctl", "cat", service],
        capture_output=True, text=True
    )
    if result.returncode != 0:
        print(f"\nService '{service}' not configured")
        print("Run 'sudo mole qbittorrent setup' to create it")
        return 0

    # Get service status
    result = subprocess.run(
        ["systemctl", "is-active", service],
        capture_output=True, text=True
    )
    status = result.stdout.strip()
    print(f"\nService: {status}")

    result = subprocess.run(
        ["systemctl", "is-enabled", service],
        capture_output=True, text=True
    )
    enabled = result.stdout.strip()
    print(f"Enabled: {enabled}")

    if status == "active":
        # Get more details
        result = subprocess.run(
            ["systemctl", "show", service, "--property=MainPID"],
            capture_output=True, text=True
        )
        pid = result.stdout.strip().split('=')[1] if '=' in result.stdout else 'unknown'
        print(f"PID: {pid}")

        # Get config for web URL
        config = Config()
        print(f"\nWeb UI: http://{config.veth_vpn_ip}:8080")
        print(f"        http://localhost:8080 (if socat configured)")

    return 0



def _qbittorrent_setup(args):
    """Setup qBittorrent to run in VPN namespace"""
    print(f"MOLE v{VERSION} - qBittorrent Setup")
    print("=" * 50)

    if os.geteuid() != 0:
        print("Error: setup must be run as root (sudo mole qbittorrent setup)")
        return 1

    # Check if qbittorrent-nox is installed
    result = run_cmd(["which", "qbittorrent-nox"], check=False)
    if result.returncode != 0:
        print("Error: qbittorrent-nox is not installed")
        print("Install with: sudo apt install qbittorrent-nox")
        return 1
    print("qbittorrent-nox: found")

    # Check for existing qbittorrent services
    existing_services = []
    for svc in ['qbittorrent-nox', 'qbittorrent-nox@', 'qbittorrent']:
        # Check both system and user services
        result = subprocess.run(
            ["systemctl", "list-unit-files", f"{svc}*"],
            capture_output=True, text=True
        )
        if svc in result.stdout:
            existing_services.append(svc)

    # Also check if any qbittorrent service is active
    result = subprocess.run(
        ["systemctl", "is-active", "qbittorrent-nox"],
        capture_output=True, text=True
    )
    qb_running = result.stdout.strip() == "active"

    if qb_running or existing_services:
        print(f"\nExisting qBittorrent service detected:")
        result = subprocess.run(
            ["systemctl", "status", "qbittorrent-nox", "--no-pager", "-l"],
            capture_output=True, text=True
        )
        if result.returncode == 0:
            # Show first few lines of status
            for line in result.stdout.split('\n')[:5]:
                print(f"  {line}")

        print("\nThe existing service runs qBittorrent outside the VPN namespace.")
        print("To use MOLE's VPN protection, we need to disable this service.")
        response = input("\nDisable and stop the existing service? [y/N]: ").strip().lower()

        if response in ('y', 'yes'):
            print("\nStopping qbittorrent-nox service...")
            subprocess.run(["systemctl", "stop", "qbittorrent-nox"], check=False)
            print("Disabling qbittorrent-nox service...")
            subprocess.run(["systemctl", "disable", "qbittorrent-nox"], check=False)
            print("Existing service disabled.")
        else:
            print("\nSetup cancelled. Disable the existing service first if you want VPN protection.")
            return 1

    # Get configuration
    config = Config()

    # Get user to run as - priority: args > config > auto-detect
    user = getattr(args, 'user', None)
    if not user:
        user = config.qb_user
    if not user:
        # Try to find a non-root user
        import pwd
        for p in pwd.getpwall():
            if 1000 <= p.pw_uid < 65000 and p.pw_shell not in ('/bin/false', '/usr/sbin/nologin'):
                user = p.pw_name
                break
        if not user:
            user = input("Enter username to run qBittorrent as: ").strip()
            if not user:
                print("Error: Username required")
                return 1

    # Get port - priority: args > config > default
    port = getattr(args, 'port', None)
    if not port:
        port = config.qb_port or 8080

    print(f"\nConfiguration:")
    print(f"  User: {user}")
    print(f"  Namespace: {config.netns}")
    print(f"  Web UI Port: {port}")

    # Update config file with QB_PORT and QB_USER
    config_file = Path(DEFAULT_CONFIG_FILE)
    if config_file.exists():
        content = config_file.read_text()
        updated = False

        # Update or add QB_PORT
        if 'QB_PORT=' in content:
            new_content = re.sub(r'QB_PORT=\d*', f'QB_PORT={port}', content)
        elif 'QB_API_URL=' in content:
            # Replace QB_API_URL with QB_PORT
            new_content = re.sub(r'QB_API_URL=.*', f'QB_PORT={port}', content)
        else:
            new_content = content.rstrip() + f'\nQB_PORT={port}\n'
        if new_content != content:
            content = new_content
            updated = True

        # Update or add QB_USER
        if 'QB_USER=' in content:
            new_content = re.sub(r'QB_USER=.*', f'QB_USER={user}', content)
        else:
            new_content = content.rstrip() + f'\nQB_USER={user}\n'
        if new_content != content:
            content = new_content
            updated = True

        if updated:
            config_file.write_text(content)
            print(f"\nUpdated config: {config_file}")

    # Generate service file using apply_config
    print("\nCreating service files...")
    _qbittorrent_apply_config(verbose=True)

    print("\nService created successfully!")
    print("\nNext steps:")
    print("  1. Start MOLE first:        sudo systemctl start mole")
    print("  2. Start qBittorrent:       sudo systemctl start qbittorrent-mole")
    print("  3. Enable on boot:          sudo systemctl enable qbittorrent-mole")
    print(f"  4. Access Web UI at:        http://localhost:{port}")
    print(f"                              (or http://{config.veth_vpn_ip}:{port})")

    # Ask if user wants to enable now
    response = input("\nEnable and start qbittorrent-mole now? [Y/n]: ").strip().lower()
    if response not in ('n', 'no'):
        print("\nEnabling qbittorrent-mole...")
        subprocess.run(["systemctl", "enable", "qbittorrent-mole"], check=False)

        # Check if mole is running
        result = subprocess.run(
            ["systemctl", "is-active", "mole"],
            capture_output=True, text=True
        )
        if result.stdout.strip() != "active":
            print("Note: MOLE service is not running. Start it first:")
            print("  sudo systemctl start mole")
        else:
            print("Starting qbittorrent-mole...")
            result = subprocess.run(
                ["systemctl", "start", "qbittorrent-mole"],
                capture_output=True, text=True
            )
            if result.returncode == 0:
                print("qBittorrent started in VPN namespace!")
            else:
                print(f"Failed to start: {result.stderr}")
                return 1

    return 0


def _qbittorrent_control(action):
    """Start/stop/enable/disable qbittorrent-mole service"""
    if os.geteuid() != 0:
        print(f"Error: {action} must be run as root (sudo mole qbittorrent {action})")
        return 1

    service = "qbittorrent-mole"

    # Check if service exists
    result = subprocess.run(
        ["systemctl", "cat", service],
        capture_output=True, text=True
    )
    if result.returncode != 0:
        print(f"Error: {service} service not found")
        print("Run 'sudo mole qbittorrent setup' first")
        return 1

    print(f"{action.capitalize()}ing {service}...")
    result = subprocess.run(
        ["systemctl", action, service],
        capture_output=True, text=True
    )

    if result.returncode == 0:
        print(f"Service {action}ed successfully")

        # Show status after start
        if action == 'start':
            import time
            time.sleep(1)
            _qbittorrent_status()
    else:
        print(f"Failed: {result.stderr}")
        return 1

    return 0


def _qbittorrent_status():
    """Show qbittorrent-mole service status"""
    service = "qbittorrent-mole"

    print(f"MOLE v{VERSION} - qBittorrent Status")
    print("=" * 50)

    # Check if service exists
    result = subprocess.run(
        ["systemctl", "cat", service],
        capture_output=True, text=True
    )
    if result.returncode != 0:
        print(f"\nService '{service}' not configured")
        print("Run 'sudo mole qbittorrent setup' to create it")
        return 0

    # Get service status
    result = subprocess.run(
        ["systemctl", "is-active", service],
        capture_output=True, text=True
    )
    status = result.stdout.strip()
    print(f"\nService: {status}")

    result = subprocess.run(
        ["systemctl", "is-enabled", service],
        capture_output=True, text=True
    )
    enabled = result.stdout.strip()
    print(f"Enabled: {enabled}")

    if status == "active":
        # Get more details
        result = subprocess.run(
            ["systemctl", "show", service, "--property=MainPID"],
            capture_output=True, text=True
        )
        pid = result.stdout.strip().split('=')[1] if '=' in result.stdout else 'unknown'
        print(f"PID: {pid}")

        # Get config for web URL
        config = Config()
        # Get port from qBittorrent service
        result = subprocess.run(
            ["systemctl", "cat", service],
            capture_output=True, text=True
        )
        qb_port = 8080
        if "--webui-port=" in result.stdout:
            match = re.search(r'--webui-port=(\d+)', result.stdout)
            if match:
                qb_port = match.group(1)

        print(f"\nWeb UI: http://{config.veth_vpn_ip}:{qb_port}")

        # Check if passthrough is active
        pt_result = subprocess.run(
            ["systemctl", "is-active", "qbittorrent-passthrough"],
            capture_output=True, text=True
        )
        if pt_result.stdout.strip() == "active":
            print(f"        http://localhost:{qb_port} (passthrough active)")
        else:
            print(f"        (localhost passthrough not configured)")

    return 0


def _qbittorrent_passthrough(args):
    """Enable localhost passthrough for qBittorrent Web UI"""
    print(f"MOLE v{VERSION} - qBittorrent Passthrough")
    print("=" * 50)

    if os.geteuid() != 0:
        print("Error: passthrough must be run as root (sudo mole qbittorrent passthrough)")
        return 1

    # Check if socat is installed
    result = subprocess.run(["which", "socat"], capture_output=True)
    if result.returncode != 0:
        print("Error: socat is not installed")
        print("Install with: sudo apt install socat")
        return 1

    # Check if qbittorrent-mole service exists
    result = subprocess.run(
        ["systemctl", "cat", "qbittorrent-mole"],
        capture_output=True, text=True
    )
    if result.returncode != 0:
        print("Error: qbittorrent-mole service not found")
        print("Run 'sudo mole qbittorrent setup' first")
        return 1

    config = Config()
    pt_path = Path("/etc/systemd/system/qbittorrent-passthrough.service")

    # Check if passthrough already exists
    if pt_path.exists():
        print(f"Passthrough service already exists")
        result = subprocess.run(
            ["systemctl", "is-active", "qbittorrent-passthrough"],
            capture_output=True, text=True
        )
        if result.stdout.strip() == "active":
            print(f"Status: active (localhost:{config.qb_port} -> {config.veth_vpn_ip}:{config.qb_port})")
        else:
            print("Status: inactive")
            response = input("Start it? [Y/n]: ").strip().lower()
            if response in ('', 'y', 'yes'):
                subprocess.run(["systemctl", "start", "qbittorrent-passthrough"], check=False)
                print("Passthrough started!")
        return 0

    # Create passthrough service using apply_config
    print(f"Creating localhost passthrough for port {config.qb_port}...")
    _qbittorrent_apply_config(enable_passthrough=True, verbose=True)

    subprocess.run(["systemctl", "enable", "qbittorrent-passthrough"], check=False)
    subprocess.run(["systemctl", "start", "qbittorrent-passthrough"], check=False)

    print(f"\nPassthrough enabled!")
    print(f"qBittorrent Web UI: http://localhost:{config.qb_port}")

    return 0


def _qbittorrent_port(args):
    """Change qBittorrent Web UI port"""

    if os.geteuid() != 0:
        print("Error: port must be run as root (sudo mole qbittorrent port <port>)")
        return 1

    new_port = getattr(args, 'port', None)
    if not new_port:
        print("Error: Please specify a port number")
        print("Usage: sudo mole qbittorrent port --port <port>")
        return 1

    print(f"MOLE v{VERSION} - Change qBittorrent Port")
    print("=" * 50)
    print(f"\nChanging port to {new_port}...")

    # Update config file - replace QB_PORT or QB_API_URL
    config_file = Path(DEFAULT_CONFIG_FILE)
    if config_file.exists():
        content = config_file.read_text()

        # Update QB_PORT if present, otherwise update QB_API_URL
        if 'QB_PORT=' in content:
            new_content = re.sub(r'QB_PORT=\d+', f'QB_PORT={new_port}', content)
        else:
            new_content = re.sub(
                r'(QB_API_URL=http://[^:]+:)\d+',
                f'\\g<1>{new_port}',
                content
            )

        if new_content != content:
            config_file.write_text(new_content)
            print(f"  Updated: {config_file}")
        else:
            print(f"  No change needed: {config_file}")
    else:
        print(f"  Config not found: {config_file}")
        return 1

    # Apply config to regenerate service files
    print("\nRegenerating service files...")
    _qbittorrent_apply_config(verbose=True)

    # Restart services if running
    print("\nRestarting services...")
    for service in ["qbittorrent-mole", "qbittorrent-passthrough"]:
        result = subprocess.run(
            ["systemctl", "is-active", service],
            capture_output=True, text=True
        )
        if result.stdout.strip() == "active":
            subprocess.run(["systemctl", "restart", service], check=False)
            print(f"  Restarted: {service}")

    config = Config()
    pt_service = Path("/etc/systemd/system/qbittorrent-passthrough.service")

    print(f"\nqBittorrent port changed to {new_port}")
    print(f"Web UI: http://{config.veth_vpn_ip}:{new_port}")
    if pt_service.exists():
        print(f"        http://localhost:{new_port}")

    return 0



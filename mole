def cmd_init(args):
    """Initialize MOLE directory structure and config"""
    print(f"MOLE v{VERSION} - Initialization")
    print("=" * 40)

    config_dir = Path(DEFAULT_CONFIG_DIR)
    state_dir = Path(DEFAULT_STATE_DIR)
    providers_dir = config_dir / "providers"
    config_file = Path(DEFAULT_CONFIG_FILE)

    # Check for root
    if os.geteuid() != 0:
        print("Error: init must be run as root (sudo mole init)")
        return 1

    # Create directories
    print(f"\nCreating directories...")
    for d in [config_dir, state_dir, providers_dir]:
        if not d.exists():
            d.mkdir(parents=True, mode=0o755)
            print(f"  Created: {d}")
        else:
            print(f"  Exists:  {d}")

    # Write PIA CA cert
    pia_cert_path = providers_dir / "pia-ca.crt"
    if not pia_cert_path.exists() or args.force:
        pia_cert_path.write_text(PIA_CA_CERT)
        print(f"  Created: {pia_cert_path}")
    else:
        print(f"  Exists:  {pia_cert_path}")

    # Write config template
    if not config_file.exists() or args.force:
        config_file.write_text(CONFIG_TEMPLATE)
        config_file.chmod(0o600)  # Restrict access (contains credentials)
        print(f"  Created: {config_file}")
        print(f"\n*** IMPORTANT: Edit {config_file} with your credentials ***")
    else:
        print(f"  Exists:  {config_file} (use --force to overwrite)")

    print(f"\nDirectory structure:")
    print(f"  {DEFAULT_CONFIG_DIR}/")
    print(f"    config           <- Your configuration (edit this!)")
    print(f"    providers/")
    print(f"      pia-ca.crt     <- PIA CA certificate")
    print(f"  {DEFAULT_STATE_DIR}/")
    print(f"    (runtime state files)")
    print(f"  {DEFAULT_WG_CONF}")
    print(f"    (generated WireGuard config)")

    print(f"\nNext steps:")
    print(f"  1. Edit {config_file} with your VPN credentials")
    print(f"  2. Run: sudo systemctl start mole")
    print(f"  3. Check status: mole status")

    return 0


def cmd_status(args):
    """Show current MOLE status"""
    state_dir = Path(DEFAULT_STATE_DIR)
    netns = "vpn"

    print(f"MOLE v{VERSION} - Status")
    print("=" * 40)

    # Check for root (needed to query namespace)
    if os.geteuid() != 0:
        print("\nNote: Run with sudo for full status (sudo mole status)")
        print("      Some information may be unavailable.\n")

    # Check if service is running
    result = subprocess.run(
        ["systemctl", "is-active", "mole"],
        capture_output=True, text=True
    )
    service_status = result.stdout.strip()
    print(f"\nService: {service_status}")

    # Check namespace exists
    result = run_cmd(["ip", "netns", "list"], check=False)
    ns_exists = netns in result.stdout
    print(f"Namespace '{netns}': {'exists' if ns_exists else 'missing'}")

    if not ns_exists:
        return 0

    # Check WireGuard interface
    result = run_in_netns(["ip", "link", "show", "mole"], netns, check=False)
    if "Operation not permitted" in result.stderr:
        print(f"WireGuard interface: (requires sudo)")
        wg_up = False
    else:
        wg_up = result.returncode == 0
        print(f"WireGuard interface: {'up' if wg_up else 'down'}")

    if wg_up:
        # Get WireGuard details
        result = run_in_netns(["wg", "show", "mole"], netns, check=False)
        if result.returncode == 0:
            for line in result.stdout.split('\n'):
                if 'endpoint:' in line:
                    print(f"  Endpoint: {line.split('endpoint:')[1].strip()}")
                if 'latest handshake:' in line:
                    print(f"  Last handshake: {line.split('latest handshake:')[1].strip()}")
                if 'transfer:' in line:
                    print(f"  Transfer: {line.split('transfer:')[1].strip()}")

    # Read state files
    print(f"\nState:")
    for name in ["hostname", "server_ip", "port"]:
        state_file = state_dir / name
        if state_file.exists():
            print(f"  {name}: {state_file.read_text().strip()}")

    # Get public IP through VPN
    if wg_up:
        result = run_in_netns(["curl", "-s", "-m", "5", "https://ipinfo.io/ip"], netns, check=False)
        if result.returncode == 0:
            print(f"  public_ip: {result.stdout.strip()}")

    return 0



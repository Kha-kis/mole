  sudo mole qbittorrent start  # Start qBittorrent service
  sudo mole qbittorrent passthrough  # Enable localhost:port access
  sudo mole qbittorrent port -p 9090  # Change Web UI port
  mole qbittorrent status      # Check qBittorrent status

def cmd_dns(args):
    """Test DNS over TLS functionality"""
    config = Config(args.config if hasattr(args, 'config') and args.config else DEFAULT_CONFIG_FILE)

    print(f"MOLE v{VERSION} - DNS over TLS Test")
    print("=" * 50)

    # Check if DOT is enabled in config
    if not config.dot_enabled:
        print("\n⚠ DNS over TLS is not enabled in config")
        print("  Add DOT_ENABLED=true to your config file")
        return 1

    dot_bind = config.dot_bind
    dot_port = config.dot_port

    print(f"\nDOT Server: {dot_bind}:{dot_port}")
    print(f"Upstream: {config.dot_upstream}")
    print(f"Block ads: {config.dot_block_ads}")
    print(f"Block malware: {config.dot_block_malware}")
    print(f"Block tracking: {config.dot_block_tracking}")

    # Test domains
    test_domains = [
        ("google.com", "Normal resolution"),
        ("cloudflare.com", "Normal resolution"),
    ]

    # Add blocked domain tests if filtering is enabled
    if config.dot_block_ads:
        test_domains.append(("doubleclick.net", "Should be BLOCKED (ads)"))
        test_domains.append(("pagead2.googlesyndication.com", "Should be BLOCKED (ads)"))
    if config.dot_block_malware:
        test_domains.append(("malware.testcategory.com", "Malware test domain"))

    print("\n" + "-" * 50)
    print("DNS Resolution Tests")
    print("-" * 50)

    # Determine if we should test from namespace or host
    use_namespace = args.namespace if hasattr(args, 'namespace') and args.namespace else False

    for domain, description in test_domains:
        print(f"\n{domain}")
        print(f"  Expected: {description}")

        # Build dig command
        dig_cmd = ["dig", "+short", "+time=5", "+tries=2", f"@{dot_bind}", domain]

        try:
            if use_namespace:
                result = run_in_netns(dig_cmd, config.netns, check=False)
            else:
                result = subprocess.run(dig_cmd, capture_output=True, text=True, timeout=10)

            if result.returncode == 0:
                output = result.stdout.strip()
                if output:
                    # Got IP addresses - domain resolved
                    ips = output.split('\n')[:2]  # Show max 2 IPs
                    print(f"  Result: ✓ Resolved → {', '.join(ips)}")
                else:
                    # Empty response - likely NXDOMAIN (blocked)
                    print(f"  Result: ✗ BLOCKED (NXDOMAIN)")
            else:
                print(f"  Result: ✗ Query failed (server may not be running)")

        except subprocess.TimeoutExpired:
            print(f"  Result: ✗ Timeout (server may not be running)")
        except Exception as e:
            print(f"  Result: ✗ Error: {e}")

    # Additional connectivity test
    print("\n" + "-" * 50)
    print("Upstream Connectivity Test")
    print("-" * 50)

    upstream_ip, upstream_port = DOT_PROVIDERS.get(
        config.dot_upstream.lower(),
        DOT_PROVIDERS['cloudflare']
    )
    if config.dot_upstream.lower() == 'custom' and config.dot_custom_server:
        custom = config.dot_custom_server
        if ':' in custom:
            upstream_ip, upstream_port = custom.rsplit(':', 1)
            upstream_port = int(upstream_port)
        else:
            upstream_ip = custom

    print(f"\nTesting TLS connection to {upstream_ip}:{upstream_port}...")

    try:
        import ssl
        import socket
        ctx = ssl.create_default_context()
        with socket.create_connection((upstream_ip, upstream_port), timeout=5) as sock:
            with ctx.wrap_socket(sock, server_hostname=upstream_ip) as ssock:
                print(f"  Result: ✓ TLS connection successful")
                print(f"  TLS version: {ssock.version()}")
    except Exception as e:
        print(f"  Result: ✗ TLS connection failed: {e}")

    print("\n" + "=" * 50)
    print("Usage examples:")
    print(f"  dig @{dot_bind} example.com")
    print(f"  nslookup example.com {dot_bind}")
    print("=" * 50)

    return 0


def cmd_apikey(args):
    """Generate or show API key"""
    import secrets

    action = args.action if hasattr(args, 'action') and args.action else 'generate'
    config_path = args.config if hasattr(args, 'config') and args.config else DEFAULT_CONFIG_FILE

    if action == 'generate':
        # Check if there's already a key in config
        existing_key = None
        try:
            config = Config(config_path)
            existing_key = config.http_api_key
        except:
            pass

        if existing_key:
            print(f"An API key already exists in config.")
            if len(existing_key) > 12:
                masked = existing_key[:8] + '...' + existing_key[-4:]
            else:
                masked = '***'
            print(f"Current key (masked): {masked}")
            response = input("\nGenerate a new key and replace it? [y/N]: ").strip().lower()
            if response not in ('y', 'yes'):
                print("Aborted.")
                return 0
            print()

        # Generate a secure random API key
        api_key = secrets.token_urlsafe(32)

        print(f"MOLE v{VERSION} - API Key Generator")
        print("=" * 50)
        print(f"\nGenerated API Key:\n")
        print(f"  {api_key}")

        # Offer to auto-apply to config
        print()
        response = input(f"Add this key to {config_path}? [Y/n]: ").strip().lower()
        if response in ('', 'y', 'yes'):
            try:
                # Read current config
                with open(config_path, 'r') as f:
                    config_content = f.read()

                # Check if HTTP_API_KEY line exists
                if re.search(r'^HTTP_API_KEY=', config_content, re.MULTILINE):
                    # Replace existing key
                    config_content = re.sub(
                        r'^HTTP_API_KEY=.*$',
                        f'HTTP_API_KEY={api_key}',
                        config_content,
                        flags=re.MULTILINE
                    )
                else:
                    # Add new key (append to end)
                    if not config_content.endswith('\n'):
                        config_content += '\n'
                    config_content += f'\n# HTTP API Authentication\nHTTP_API_KEY={api_key}\n'

                # Write back
                with open(config_path, 'w') as f:
                    f.write(config_content)

                print(f"\nAPI key added to {config_path}")
                print("Restart MOLE for the new key to take effect: sudo systemctl restart mole")
            except PermissionError:
                print(f"\nError: Permission denied writing to {config_path}")
                print("Run with sudo to update config, or add manually:")
                print(f"\n  HTTP_API_KEY={api_key}")
            except Exception as e:
                print(f"\nError updating config: {e}")
                print("Add manually to your config file:")
                print(f"\n  HTTP_API_KEY={api_key}")
        else:
            print(f"\nAdd this to your config file ({config_path}):\n")
            print(f"  HTTP_API_KEY={api_key}")

        print(f"\nUsage examples:\n")
        print(f"  # Using X-API-Key header")
        print(f"  curl -H 'X-API-Key: {api_key}' http://127.0.0.1:8080/v1/status")
        print(f"\n  # Using Authorization header")
        print(f"  curl -H 'Authorization: Bearer {api_key}' http://127.0.0.1:8080/v1/status")
        print(f"\n  # Using query parameter")
        print(f"  curl 'http://127.0.0.1:8080/v1/status?api_key={api_key}'")
        print("=" * 50)

    elif action == 'show':
        # Show current API key from config
        try:
            config = Config(config_path)
        except PermissionError:
            print(f"Error: Permission denied reading {config_path}")
            print("Run with sudo: sudo mole api-key show")
            return 1

        api_key = config.http_api_key

        print(f"MOLE v{VERSION} - API Key Status")
        print("=" * 50)

        if api_key:
            print(f"\nAPI Key configured: Yes")
            print(f"\nCurrent key:\n")
            print(f"  {api_key}")
            print(f"\nUsage examples:\n")
            print(f"  curl -H 'X-API-Key: {api_key}' http://127.0.0.1:8080/v1/status")
        else:
            print(f"\nAPI Key configured: No")
            print(f"\nRun 'mole api-key generate' to create one")

        print("=" * 50)

    return 0



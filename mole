# Provider Factory
# ═══════════════════════════════════════════════════════════════════════════

def get_vpn_provider(config: Config, state: VPNState) -> VPNProvider:
    """Factory function to get VPN provider"""
    providers = {
        "pia": PIAProvider,
        # Future: "mullvad": MullvadProvider,
        # Future: "protonvpn": ProtonVPNProvider,
    }

    provider_name = config.vpn_provider.lower()
    if provider_name not in providers:
        raise ValueError(f"Unknown VPN provider: {provider_name}")

    return providers[provider_name](config, state)


def get_torrent_client(config: Config) -> TorrentClient:
    """Factory function to get torrent client"""
    clients = {
        "qbittorrent": QBittorrentClient,
        # Future: "transmission": TransmissionClient,
        # Future: "deluge": DelugeClient,
    }

    client_name = config.torrent_client.lower()
    if client_name not in clients:
        raise ValueError(f"Unknown torrent client: {client_name}")

    return clients[client_name](config)


